{
  "name": "discord-store-bot",
  "version": "1.0.0",
  "description": "Discord Bot + Website Store with centralized transaction engine",
  "main": "dist/dashboard/main/electronMain.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node scripts/start.ts",
    "dev:bot": "ts-node src/bot/index.ts",
    "dev:website": "ts-node src/website/index.ts",
    "dev:api": "ts-node src/api/index.ts",
    "dashboard": "electron .",
    "build:dashboard": "electron-builder",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:vitest": "vitest",
    "test:reconcile": "vitest tests/reconciliation",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "discord",
    "bot",
    "store",
    "payment"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.14.1",
    "express": "^4.18.2",
    "socket.io": "^4.6.1",
    "socket.io-client": "^4.6.1",
    "mysql2": "^3.9.1",
    "mongodb": "^6.3.0",
    "dotenv": "^16.4.1",
    "ejs": "^3.1.9",
    "winston": "^3.11.0",
    "uuid": "^9.0.1",
    "joi": "^17.12.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "electron-squirrel-startup": "^1.0.0",
    "bullmq": "^5.1.5",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.16",
    "@types/express": "^4.17.21",
    "@types/uuid": "^9.0.7",
    "@types/cors": "^2.8.17",
    "@types/jest": "^29.5.12",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.14",
    "@typescript-eslint/eslint-plugin": "^6.20.0",
    "@typescript-eslint/parser": "^6.20.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "vitest": "^1.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ]
  }
}
