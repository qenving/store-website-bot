# Database Configuration
DB_DRIVER=json
# DB_DRIVER options: json | mysql | mongodb

# MySQL Configuration (if DB_DRIVER=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=discord_store

# MongoDB Configuration (if DB_DRIVER=mongodb)
MONGODB_URI=mongodb://localhost:27017/discord_store

# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_GUILD_ID=your_guild_id_here

# Website Configuration
WEBSITE_PORT=3000
WEBSITE_HOST=localhost

# Internal API Configuration
API_PORT=3001
API_HOST=localhost
API_SECRET=your_api_secret_here

# Socket.IO Configuration
SOCKET_PORT=3002
SOCKET_HOST=localhost

# Environment
NODE_ENV=development

# Logging
LOG_LEVEL=info
# LOG_LEVEL options: error | warn | info | debug
